# Copiar para .env e preencher. O .env nunca deve ser commitado.
MONGO_URI=mongodb+srv://<utilizador>:<password>@<cluster>.mongodb.net/bookstore?retryWrites=true&w=majority
PORT=8080
API_PREFIX=/bookstore

# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=2d
REFRESH_TOKEN_EXPIRES=7d

# Segredo dos cookies de sessão do painel AdminJS (/admin)
COOKIE_PASSWORD=

# Origens permitidas para CORS, separadas por vírgula (ou * para todas)
CORS_ORIGIN=*

# Administrador inicial criado por: npm run seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bookstore.local
ADMIN_PASSWORD=
